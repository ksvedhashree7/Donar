# Root environment for local development
POSTGRES_DB=organ_match
POSTGRES_USER=app
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://app:apppass@db:5432/organ_match
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=development-only-change-me
TOTP_ENCRYPTION_KEY=development-only-totp-key-change-me

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
