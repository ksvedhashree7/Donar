# Root environment for local development
POSTGRES_DB=organ_match
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_LOCAL_DB_PASSWORD@db:5432/organ_match
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# MinIO
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Google Maps Platform - Live Donor Tracking and ETA
# Optional server-side key for Routes API
GOOGLE_MAPS_API_KEY=
# Browser-restricted key for Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=
