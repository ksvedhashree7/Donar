{
  "name": "uthiram",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace=@uthiram/client\" \"npm:dev --workspace=@uthiram/server\"",
    "build": "npm run build --workspace=@uthiram/client",
    "start": "npm run start --workspace=@uthiram/server",
    "seed": "npm run seed --workspace=@uthiram/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
